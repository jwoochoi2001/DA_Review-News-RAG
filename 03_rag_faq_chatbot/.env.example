# 이 파일을 .env 로 복사해서 사용하세요. (.env 는 .gitignore 에 들어 있어 배포되지 않습니다)

# LLM 연결 방식: claude_code (구독, 기본) / api (API 키) / mock (LLM 없이 화면·출처 표시만 테스트)
LLM_BACKEND=claude_code

# [claude_code] 터미널에서 `claude auth login` 으로 먼저 로그인하세요. (haiku / sonnet / opus)
CLAUDE_CODE_MODEL=haiku

# [api] LLM_BACKEND=api 일 때만 필요합니다. 키를 이 예시 파일에 직접 적지 마세요.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# 검색 설정(선택)
# KNOWLEDGE_SOURCE=wiki      # wiki(기본, LLM Wiki 검색) / raw(원문 매뉴얼·FAQ 직접 검색)
# WIKI_MIN_SIMILARITY=0.81
# TOP_K=4
# MIN_SIMILARITY=0.80


